{
  "servers": {
    "eventflow-local": {
      "type": "stdio",
      "command": "/Users/igorvuleta/.dotnet/dotnet",
      "args": [
        "run",
        "--project",
        "src/EventFlowMcp.Tool/EventFlowMcp.Tool.csproj",
        "--",
        "Operations:Provider=InMemory",
        "Rag:Provider=InMemory"
      ]
    },
    "eventflow-demo-projection": {
      "type": "stdio",
      "command": "/Users/igorvuleta/.dotnet/dotnet",
      "args": [
        "run",
        "--project",
        "src/EventFlowMcp.Tool/EventFlowMcp.Tool.csproj",
        "--",
        "Operations:Provider=LocalProjection",
        "Operations:LocalProjection:Path=${input:eventflowProjectionPath}",
        "Rag:Provider=InMemory"
      ]
    },
    "eventflow-http": {
      "type": "http",
      "url": "http://localhost:3001/mcp",
      "headers": {
        "X-MCP-API-Key": "${input:eventflowMcpApiKey}"
      }
    }
  },
  "inputs": [
    {
      "id": "eventflowMcpApiKey",
      "type": "promptString",
      "description": "EventFlow MCP API key",
      "password": true
    },
    {
      "id": "eventflowProjectionPath",
      "type": "promptString",
      "description": "Absolute path to the local EventFlow demo projection JSON file",
      "password": false
    }
  ]
}
