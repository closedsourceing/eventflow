{
  "AllowedHosts": "*",
  "Operations": {
    "Provider": "InMemory",
    "ServiceControl": {
      "ApiBaseUrl": "http://localhost:33333/api/",
      "BearerToken": "",
      "PageSize": 100
    },
    "LocalProjection": {
      "Path": ""
    },
    "PostgresProjection": {
      "ConnectionString": ""
    }
  },
  "Mcp": {
    "ApiKey": "",
    "RateLimitPerMinute": 120,
    "MaxRequestBodyBytes": 262144
  },
  "Rag": {
    "Provider": "InMemory",
    "Http": {
      "Endpoint": "http://localhost:5050",
      "SearchPath": "/rag/search",
      "ApiKey": "",
      "ApiKeyHeaderName": "X-RAG-API-Key"
    }
  }
}
